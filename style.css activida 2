body {
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
    background-color: #f2f2f2;
    text-align: center;
}

.dive {
    width: 500px;
    margin: 50px auto;
    padding: 30px;
    background-color: white;
    border-radius: 15px;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
}

.dive2 {
    width: 500px;
    margin: 50px auto;
    padding: 30px;
    background-color: white;
    border-radius: 15px;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
}

h1 {
    margin-bottom: 10px;
}

h2 {
    margin-top: 10px;
}

label {
    display: inline-block;
    width: 180px;
    text-align: right;
    margin-right: 10px;
}

input {
    padding: 8px;
    border: 1px solid #999;
    border-radius: 5px;
}

button {
    padding: 10px 25px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 16px;
}

img {
    width: 250px;
    height: auto;
    border-radius: 10px;
    margin: 20px;
}
/* Ventana emergente */
.modal {
    display: none;
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    align-items: center;
}

.modal-contenido {
    width: 400px;
    max-width: 85%;
    padding: 30px;
    background-color: white;
    border-radius: 15px;
    text-align: center;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
}

.icono-pregunta {
    width: 70px;
    height: 70px;
    margin: 0 auto 20px;
    border: 4px solid #4B9CDB;
    border-radius: 50%;
    color: #4B9CDB;
    font-size: 50px;
    line-height: 70px;
    font-weight: bold;
}

.modal-contenido button {
    margin: 8px;
}
